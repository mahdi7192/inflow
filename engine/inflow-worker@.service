[Unit]
Description=inFlow Automation Worker for Instagram Account @%i
After=network.target inflow.service
Wants=inflow.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/inflow
ExecStart=/root/.hermes/tools/python-3.14.7+20260901-linux-x64/bin/python3 /opt/inflow/engine/worker.py --account %i --loop --interval 60
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
